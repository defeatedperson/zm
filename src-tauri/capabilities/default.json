{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口、各壁纸窗口与静默启动的预热窗口的默认能力",
  "windows": ["main", "wallpaper-*", "warmup"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "autostart:allow-is-enabled",
    "autostart:allow-enable",
    "autostart:allow-disable"
  ]
}
